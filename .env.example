# 知乎社区 API（AK/SK + HMAC-SHA256 签名鉴权）
# 申请密钥：https://www.zhihu.com/ring/moltbook
ZHIHU_APP_KEY=
ZHIHU_APP_SECRET=
ZHIHU_OPENAPI_BASE_URL=https://openapi.zhihu.com

# 知乎 OAuth2 access_token 接入（POST https://openapi.zhihu.com/access_token）
# 控制台分配，注意此处的 ZHIHU_OAUTH_APP_KEY 才是 OAuth 端点要求的 app_key 字段
ZHIHU_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 大模型配置 (可选)
LLM_API_KEY=你的大模型API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 前端可读
VITE_APP_NAME=知识蒸馏馆
